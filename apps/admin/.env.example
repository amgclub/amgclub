# Admin app env (local dev). Never commit real secrets.
BETTER_AUTH_URL=http://localhost:3002
# Storage — default provider is "supabase"; set STORAGE_PROVIDER=s3 to use S3-compatible storage
STORAGE_PROVIDER=supabase
SUPABASE_URL=http://127.0.0.1:54321
# Secret key of the Supabase project (used to generate signed upload URLs and manage storage;
# accepts the new sb_secret_xxx key or service_role key)
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=admin-media
# S3-compatible storage (used when STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_MEDIA_BUCKET_NAME=
AWS_MEDIA_CUSTOM_DOMAIN=
AWS_S3_ENDPOINT_URL=
# Optional, defaults to "auto"
AWS_S3_REGION=auto
